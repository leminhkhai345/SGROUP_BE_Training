{
  "info": {
    "name": "Basic BE Training - Current API Test Suite",
    "description": "One request per current method+endpoint route (43 unique routes). The collection creates one MEMBER test account and uses one Login request; set loginEmail/loginPassword to an existing ADMIN for the full run. To test another identity, change those environment values and run the same Login request again. Upload requests require R2 and manual file selection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ],
  "item": [
    {
      "name": "00 - Auth (run first)",
      "item": [
        {
          "name": "Register one test MEMBER",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{memberName}}\",\n  \"email\": \"{{memberEmail}}\",\n  \"password\": \"{{memberPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Creates one normal MEMBER account. The same account can be added to the test class and assigned as its mentor."
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const stamp = Date.now();",
                  "pm.environment.set(\"memberName\", `Postman Learner ${stamp}`);",
                  "pm.environment.set(\"memberEmail\", `postman.learner.${stamp}@example.com`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "if (pm.response.code >= 200 && pm.response.code < 300 && pm.response.code !== 204) {",
                  "  const payload = pm.response.json();",
                  "  if (payload[\"data\"][\"id\"] !== undefined && payload[\"data\"][\"id\"] !== null) pm.environment.set(\"memberId\", String(payload[\"data\"][\"id\"]));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (saves accessToken)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{loginEmail}}\",\n  \"password\": \"{{loginPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Set loginEmail/loginPassword in the environment. Use an existing ADMIN to run the full suite; use the same request with a MEMBER account to test that account separately."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code >= 200 && pm.response.code < 300 && pm.response.code !== 204) {",
                  "  const payload = pm.response.json();",
                  "  if (payload[\"data\"][\"accessToken\"] !== undefined && payload[\"data\"][\"accessToken\"] !== null) pm.environment.set(\"accessToken\", String(payload[\"data\"][\"accessToken\"]));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh token (saves accessToken)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/refresh",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Uses the refreshToken cookie saved by Postman from the previous login response."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code >= 200 && pm.response.code < 300 && pm.response.code !== 204) {",
                  "  const payload = pm.response.json();",
                  "  if (payload[\"data\"][\"accessToken\"] !== undefined && payload[\"data\"][\"accessToken\"] !== null) pm.environment.set(\"accessToken\", String(payload[\"data\"][\"accessToken\"]));",
                  "}"
                ]
              }
            }
          ]
        }
      ],
      "auth": {
        "type": "noauth"
      },
      "description": "One registration request and one reusable login request. For the full end-to-end run, set loginEmail/loginPassword to an existing ADMIN account."
    },
