PORT=3000
NODE_ENV=development

# PostgreSQL Database (khớp với docker-compose.yml)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=basic_be_training
DB_USER=postgres
DB_PASSWORD=postgrespassword

# JWT Authentication
ACCESS_TOKEN_SECRET=your_access_token_secret_key_123456
ACCESS_TOKEN_EXPIRES_IN=1d

REFRESH_TOKEN_SECRET=your_refresh_token_secret_key_123456
REFRESH_TOKEN_EXPIRES_IN=7d

# Cloudflare R2 / S3 Object Storage (chỉ cần khi test upload avatar)
R2_ACCOUNT_ID=your_r2_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_r2_bucket_name
